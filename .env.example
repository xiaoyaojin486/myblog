# ============================================================
# 个人博客系统 - 环境变量模板
# 使用方式：复制本文件为 .env，放在项目根目录（启动工作目录），填写后启动
# 优先级说明：同名系统环境变量优先级高于 .env，两者任一生效即可
# 密钥类变量必须填写，缺失时应用启动会直接报错（便于及早发现配置问题）
# ============================================================

# ===== MySQL（必填：密码）=====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=myblog
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ===== 阿里云 OSS =====
# 注：OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET 已在系统环境变量中配置，此处可留空
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_DOMAIN=

# ===== JWT（必填：长度必须 >= 32 字符）=====
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ===== 管理员初始密码（首次启动自动创建 admin 账号时使用）=====
ADMIN_INIT_PASSWORD=admin123