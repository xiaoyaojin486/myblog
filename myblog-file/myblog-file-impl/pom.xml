<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.myblog</groupId>
        <artifactId>myblog-file</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>myblog-file-impl</artifactId>
    <name>myblog-file-impl</name>
    <description>文件模块 - 内部实现（OSS 图片上传/删除，包路径 com.myblog.file）</description>

    <dependencies>
        <!-- 自身 api -->
        <dependency>
            <groupId>com.myblog</groupId>
            <artifactId>myblog-file-api</artifactId>
        </dependency>

        <!-- 公共模块 -->
        <dependency>
            <groupId>com.myblog</groupId>
            <artifactId>myblog-common</artifactId>
        </dependency>

        <!-- 阿里云 OSS SDK -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>

        <!-- OSS SDK 在 JDK 9+ 运行所需的 JAXB 依赖 -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>2.3.1</version>
        </dependency>
        <dependency>
            <groupId>javax.activation</groupId>
            <artifactId>activation</artifactId>
            <version>1.1.1</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>