SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms128m -Xmx300m -XX:MaxMetaspaceSize=96m -XX:+UseSerialGC
TZ=Asia/Shanghai

# ===== MySQL：博客自己的容器 =====
# ★ v2：不再指向 myapp-mysql。容器名就是主机名 —— 在 myblog_net 里 Docker 自带 DNS 能解析
MYSQL_HOST=myblog-mysql
MYSQL_PORT=3306
MYSQL_DATABASE={{ mydb_name }}
MYSQL_USERNAME={{ mydb_user }}
MYSQL_PASSWORD={{ vault_mysql_password }}

# ★ v2 新增：只有 mysql 容器读它，后端用不到。
#   MySQL 官方镜像靠 MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD
#   在「首次启动、数据目录为空」时自动建库建账号。
#   注意变量名：后端读 MYSQL_USERNAME，官方镜像读 MYSQL_USER，
#   那个名字差异已经在 docker-compose.yml 里用 environment: 映射掉了。
MYSQL_ROOT_PASSWORD={{ vault_mysql_root_password }}

# ===== Redis：博客自己的容器 =====
REDIS_HOST=myblog-redis
REDIS_PORT=6379
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_DATABASE=0

# ===== 阿里云 OSS =====
OSS_ENDPOINT={{ vault_oss_endpoint }}
OSS_ACCESS_KEY_ID={{ vault_oss_access_key_id }}
OSS_ACCESS_KEY_SECRET={{ vault_oss_access_key_secret }}
OSS_BUCKET_NAME={{ vault_oss_bucket_name }}
OSS_DOMAIN={{ vault_oss_domain }}

# ===== JWT =====
JWT_SECRET={{ vault_jwt_secret }}
JWT_EXPIRE_HOURS=24

# ===== 首次启动创建 admin 账号用 =====
ADMIN_INIT_PASSWORD={{ vault_admin_init_password }}
