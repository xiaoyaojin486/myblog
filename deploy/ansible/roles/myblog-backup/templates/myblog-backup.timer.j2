[Unit]
Description=每天 03:17 备份博客数据库

[Timer]
# ★ 挑 03:17 而不是 03:00：整点是全世界定时任务最挤的时刻，
#   错开几分钟能避开 OSS 那边的请求高峰。
OnCalendar=*-*-* 03:17:00

# ★★ Persistent=true 是这里最要紧的一行。
#    没有它：机器在 03:17 没开着（重启、维护、死机），这一天的备份就【悄悄没了】——
#    没有任何报错，你只会在几个月后数备份文件时才发现少了几天。
#    有了它：开机后 systemd 会立刻补跑一次错过的任务。
Persistent=true

[Install]
WantedBy=timers.target
