# ===========================================================================
# Ansible 主机清单 —— 模板
#
# ★ 这个文件是【模板】，真正要用的那份叫 inventory.ini（同目录），
#   它已被 .gitignore 排除，因为它含服务器真实地址。
#
# 【为什么真身不进仓库】
#   仓库是公开的。这一行里同时有：
#       公网 IP  +  ansible_user=root  +  端口  +  私钥路径
#   等于告诉别人"用 root 这个用户名，来撞这台机器的 22 端口"。
#   2026-10-11 实测：一周内有 1599 次密码尝试失败（约每天 230 次）。
#   详见 deploy/SSH安全加固记录.md
#
# 【怎么用】
#   cp inventory.ini.example inventory.ini
#   然后把下面的 <服务器IP> 换成真实地址
# ===========================================================================

[myblog]
myblog-server ansible_host=<服务器IP> ansible_user=root ansible_port=22 ansible_ssh_private_key_file=~/.ssh/myblog_deploy

[myblog:vars]
# CentOS 8 的系统 Python 在 platform-python，显式指定比自动探测可靠
ansible_python_interpreter=/usr/bin/python3.9
